{
  "name": "er-editor",
  "version": "0.5.4",
  "description": "A minimal Electron application with TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npx buf generate && electron-vite dev",
    "build": "npx buf generate && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win && cp protoc.exe ./dist/win-unpacked",
    "build:mac": "npm run build && electron-builder --mac && cp protoc-osx ./dist/win-unpacked",
    "build:linux": "npm run build && electron-builder --linux && cp protoc-linux ./dist/win-unpacked"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.48.0",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/node": "^26.6.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "@bufbuild/buf@1.75.0": true,
    "electron-winstaller@5.4.0": true
  }
}
